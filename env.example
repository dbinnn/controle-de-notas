# O arquivo .env é criado automaticamente na primeira execução.
# Nunca envie o .env ao GitHub ou para terceiros.

# Login Google OAuth (opcional)
# Se GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET ficarem vazios, o sistema abre
# SEM login e todos os usuários viram administradores (modo demonstração).
# URI autorizada no Google Cloud:
# http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails autorizados, separados por vírgula
ALLOWED_EMAILS=usuario1@exemplo.com,usuario2@exemplo.com

# Administradores. O administrador pode restaurar banco, limpar todos,
# excluir definitivamente itens da lixeira e excluir empresas sem uso.
ADMIN_EMAILS=usuario1@exemplo.com

FLASK_DEBUG=false
PORT=5000
MAX_UPLOAD_MB=25
